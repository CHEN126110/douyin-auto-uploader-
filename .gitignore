# 敏感运行时数据（含登录态 cookie，绝不能进 public 仓库）
upload-browser-profile/
logs/
config/app_config.db

# 更新签名私钥（约定放在仓库外 %USERPROFILE%\.tauri-keys\，此处为防御性兜底）
.tauri-keys/
*.key
!*.key.pub
password.txt

# 编辑备份
*.bak

# 白底图语义抠图模型（几百 MB 的 ONNX，不进仓库，见 src/whitebg/paths.py）
/models/whitebg/

# taobao-publisher 子项目：测试 scratch 与临时产物不进仓库。
# 注意 captures/ 与 outputs/ 下的**去敏证据**是要进仓库的（对齐 protocol-research-* 惯例），
# 所以这里只忽略 tmp/。
taobao-publisher/tmp/
# pytest 在无法写 .pytest_cache 时会退化成在 rootdir 建临时目录（本机沙箱下会触发）
pytest-cache-files-*/

# 开发机私有临时资料和本地构建清单
/tmp/
/.acl_repair/
/aclprobe-*/
/tauri-app/python-sidecar/.source-manifest.json
