{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抖音袜子发布工具",
  "version": "4.0.6",
  "identifier": "com.dyin.sock-publisher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "抖音袜子发布工具",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/*": "./",
      "../../mcp-server": "mcp-server",
      "../../skills/douyin-publisher-mcp": "skills/douyin-publisher-mcp",
      "../runtime/node.exe": "mcp-runtime/node.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis_hooks.nsh"
      }
    }
  },
  "plugins": {}
}
